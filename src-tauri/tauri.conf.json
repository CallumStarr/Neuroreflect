{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NeuroReflect",
  "version": "../package.json",
  "identifier": "com.neuroreflect.journal",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NeuroReflect",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "NOAH Neurotech Ltd",
    "copyright": "Copyright 2026 NOAH Neurotech Ltd",
    "category": "Productivity",
    "shortDescription": "A private reflective journal that keeps everything on your computer",
    "longDescription": "NeuroReflect is a reflective journal with live writing telemetry, a co-pilot that asks one question at a time, and a memory of your threads and chapters. Your journal is stored on your computer and only leaves it if you choose an AI provider.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
